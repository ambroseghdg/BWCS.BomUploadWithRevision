    <add key="XASERVER" value="BWCIDEV2" />
    <add key="XASystemName" value="BWCIDEV2.BWCINC.ORG" />
    <add key="XAUser" value="NIGHTXA2XA" />
    <add key="XAPwd" value="x1234567" /> 

