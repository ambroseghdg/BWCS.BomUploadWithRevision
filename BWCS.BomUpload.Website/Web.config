-->
  <add key="MakeDelayInProcessMilliseconds" value="5000" />
  <add key="SELECT_ITMRVA" value="SELECT ITRV from AMFLIB[AS400LIB].itmrva where STID = ? AND itnbr = ?"/>
  <add key="SELECT_PSTHDR" value="SELECT COUNT(*) FROM AMFLIB[AS400LIB].PSTHDR WHERE STID = ? AND PINBR = ? AND PITR = ?"/>
  <add key="SELECT_PSTDTL" value="SELECT COUNT(*) FROM AMFLIB[AS400LIB].PSTDTL WHERE STID = ? AND PINBR = ? AND CINBR  = ? AND USRS1 = ? AND PITR = ?"/>
	  
	<!-- DEV   --> 
  <add key="XASysIConn" value="Driver={Client Access ODBC Driver (32-bit)};System=BWCIDEV2;TRANSLATE=1;Uid=NIGHTXA2XA;Pwd=x1234567"/>
