    @section scripts {
        <script type="text/javascript">

        var $jQ = jQuery.noConflict();
        const currentUrl = new URL(window.location.href);
        const params = currentUrl.searchParams;

        var qstrItmEnv = params.get('Env');
        var qstrItmNum = params.get('ParentItem');
        var LatestParentItemRevision;
        var strFinalParentItemRevision;
        // Parent Item Number must be in UPPERCASE - case sensitive when validating XA BOM and data.
        qstrItmNum = qstrItmNum ? qstrItmNum.toUpperCase() : "";

        var fromQueryString = 'N';
        $jQ("#lblNote").hide();

        // Currently used environments in the app are pulled from SQL master table.
        // Any addition to new environment will reflect in the dropdownlist automatically.

        function SETDropDownByText(ddlselector, text) {
            $jQ(ddlselector + " option").filter(function () {
                return $jQ(this).text() === text;
            }).prop("selected", true);
        }

        // helper: read cookie by name
        // if browser has document.cookie = "EnvironmentCookie=Environment=FF-BWIS; EnvironmentCookiePDM=EnvironmentPDM=QA-ENV";
        // call GetEnvCookieText("EnvironmentPDM"); TO return QA-ENV

        function GetEnvCookieText(nameKey) {
            var bomuploadcookies = document.cookie.split(";"); // split all cookies
            // alert('Index - doc. cookie: ' + document.cookie);
            for (var i = 0; i < bomuploadcookies.length; i++) {
                var eachcookie = bomuploadcookies[i].trim();
                if (eachcookie.indexOf(nameKey + "=") === 0) {
                    var rawCookie = eachcookie.substring(nameKey.length + 1);
                    // rawCookie = "EnvironmentPDM=FF-BWIS"

                    var idx = rawCookie.indexOf("=");
                    if (idx !== -1) {
                        return rawCookie.substring(idx + 1); // "FF-BWIS"
                    }
                    return rawCookie;
                }
            }
            return null;
        }

        /*
            |setCookie Usage:

            var cookieName = "EnvironmentCookie";
            var cookieValue = "Environment=" + encodeURIComponent(selectedEnv);
            setCookie(cookieName, cookieValue, 60);
        */

        function setEnvCookie(cookieName, cookieValue, days) {
            var expirationDate = new Date();
            expirationDate.setDate(expirationDate.getDate() + days);
            // alert('Index - setEnvCookie BEFORE document.cookie: ' + document.cookie);
            var cookieString = cookieName + "=" + cookieValue
                + "; expires=" + expirationDate.toUTCString()
                + "; path=/";
                // var cookieString = cookieName + "=" + cookieValue + "; expires=" + expirationDate.toUTCString() + "; path=/";
            document.cookie = cookieString;
            // alert('Index - setEnvCookie after: ' + document.cookie);
            }

            /* Maintenance Configuration Start */

            var maintenanceConfig = {
                startDay: 'Friday',      // Saturday
                startTime: '01:00',        // 22:30 (10:30 PM)
                endDay: 'Friday',          // Sunday
                endTime: '05:00',          // 05:00 (5:00 AM)
                timeZone: 'America/Chicago' // Central Time
            };

            /*
            var maintenanceConfig = {
                startDay: 'Saturday',      // Saturday
                startTime: '22:30',        // 22:30 (10:30 PM)
                endDay: 'Sunday',          // Sunday
                endTime: '05:00',          // 05:00 (5:00 AM)
                timeZone: 'America/Chicago' // Central Time
            };
            */


            /**
             * Get current time in Central Time Zone (America/Chicago)
             * Automatically handles Daylight Saving Time (DST)
             * returns {Object} Central time information
             */
            /**
     * Get current time in Central Time (America/Chicago)
     * Automatically handles CST/CDT (DST)
     */
            function getCurrentTimeInCentralTime() {
                try {
                    const now = new Date();

                    const parts = new Intl.DateTimeFormat('en-US', {
                        timeZone: 'America/Chicago',
                        weekday: 'long',
                        year: 'numeric',
                        month: '2-digit',
                        day: '2-digit',
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit',
                        hour12: false
                    }).formatToParts(now);

                    const get = (type) => parts.find(p => p.type === type)?.value;

                    let hours = parseInt(get('hour'), 10);

                    // Some environments can return "24" at midnight.
                    if (hours === 24) {
                        hours = 0;
                    }

                    const minutes = parseInt(get('minute'), 10);
                    const seconds = parseInt(get('second'), 10);

                    const dayName = get('weekday');

                    const dayNames = {
                        Sunday: 0,
                        Monday: 1,
                        Tuesday: 2,
                        Wednesday: 3,
                        Thursday: 4,
                        Friday: 5,
                        Saturday: 6
                    };

                    const day = dayNames[dayName];

                    return {
                        day: day,
                        dayName: dayName,
                        hours: hours,
                        minutes: minutes,
                        seconds: seconds,

                        timeInMinutes: (hours * 60) + minutes,

                        formatted:
                            String(hours).padStart(2, '0') + ':' +
                            String(minutes).padStart(2, '0') + ':' +
                            String(seconds).padStart(2, '0'),

                        date: now,

                        year: parseInt(get('year'), 10),
                        month: parseInt(get('month'), 10),
                        dayOfMonth: parseInt(get('day'), 10)
                    };

                } catch (error) {
                    console.error('Error getting Central Time:', error);
                    return null;
                }
            }

            /**
             * Get day name from day number
             */
            function getDayName(dayNumber) {
                var days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                return days[dayNumber] || 'Unknown';
            }

            /**
        * Parse time string "HH:MM" to minutes
        * param {string} timeString - Time in format "HH:MM"
        * returns {number} Total minutes
        */
            function parseTimeToMinutes(timeString) {
                try {
                    var parts = timeString.split(':');
                    var hours = parseInt(parts[0], 10);
                    var minutes = parseInt(parts[1], 10);

                    if (isNaN(hours) || isNaN(minutes)) {
                        console.error('Invalid time format: ' + timeString);
                        return 0;
                    }

                    return hours * 60 + minutes;
                } catch (error) {
                    console.error('Error parsing time:', error);
                    return 0;
                }
            }

            /**
             * Get day number from day name
             * param {string} dayName - Day name (e.g., "Saturday", "Sunday")
             * returns { number } Day of week(0 = Sunday, 6 = Saturday)
             */
            function getDayNumber(dayName) {
                var days = {
                    'Sunday': 0,
                    'Monday': 1,
                    'Tuesday': 2,
                    'Wednesday': 3,
                    'Thursday': 4,
                    'Friday': 5,
                    'Saturday': 6
                };

                return days[dayName] !== undefined ? days[dayName] : -1;
            }

            /*
             * Check if current time is within maintenance window
             * Saturday 22:30 to Sunday 05:00 Central Time
             */
            function isMaintenanceWindow() {
                try {
                    // Parse times from config
                    var maintenanceStartTime = parseTimeToMinutes(maintenanceConfig.startTime);
                    var maintenanceEndTime = parseTimeToMinutes(maintenanceConfig.endTime);
                    var startDay = getDayNumber(maintenanceConfig.startDay);
                    var endDay = getDayNumber(maintenanceConfig.endDay);

                    // Get CENTRAL TIME
                    var centralTimeInfo = getCurrentTimeInCentralTime();
                    var currentDay = centralTimeInfo.day;
                    var currentTime = centralTimeInfo.timeInMinutes;

                    // Log for debugging
                    console.log('=== Maintenance Window Check ===');
                    console.log('Config Start: ' + maintenanceConfig.startDay + ' ' + maintenanceConfig.startTime + ' (Day: ' + startDay + ', Time: ' + maintenanceStartTime + 'min)');
                    console.log('Config End: ' + maintenanceConfig.endDay + ' ' + maintenanceConfig.endTime + ' (Day: ' + endDay + ', Time: ' + maintenanceEndTime + 'min)');
                    console.log('Current: Day ' + currentDay + ', Time ' + currentTime + 'min (' + centralTimeInfo.hours + ':' + String(centralTimeInfo.minutes).padStart(2, '0') + ')');

                    // CASE 1: Same day maintenance (e.g., Saturday 05:55 to Saturday 06:50)
                    if (startDay === endDay) {
                        console.log('✓ Same-day maintenance window');

                        if (currentDay === startDay &&
                            currentTime >= maintenanceStartTime &&
                            currentTime < maintenanceEndTime) {

                            console.log('✓ MAINTENANCE ACTIVE (Same-day window)');
                            return true;
                        }
                    }
                    // CASE 2: Multi-day maintenance (e.g., Saturday 22:30 to Sunday 05:00)
                    else {
                        console.log('✓ Multi-day maintenance window');

                        // Check if start day and time >= start time
                        if (currentDay === startDay && currentTime >= maintenanceStartTime) {
                            console.log('✓ Maintenance Active: Start Window');
                            return true;
                        }

                        // Check if end day and time < end time
                        if (currentDay === endDay && currentTime < maintenanceEndTime) {
                            console.log('✓ Maintenance Active: End Window');
                            return true;
                        }
                    }

                    console.log('X Maintenance Not Active');
                    return false;
                } catch (error) {
                    console.error('Error checking maintenance window:', error);
                    return false;
                }
            }

            /**
              * Get next maintenance time
              */
            function getNextMaintenanceTime() {
                var now = new Date();
                var startDay = getDayNumber(maintenanceConfig.startDay);
                var dayOfWeek = now.getDay();
                var maintenanceStartTime = parseTimeToMinutes(maintenanceConfig.startTime);
                var currentTime = now.getHours() * 60 + now.getMinutes();

                var nextMaintenance = new Date(now);

                if (dayOfWeek === startDay) {
                    if (currentTime < maintenanceStartTime) {
                        nextMaintenance.setHours(parseInt(maintenanceConfig.startTime.split(':')[0]),
                            parseInt(maintenanceConfig.startTime.split(':')[1]), 0, 0);
                    } else {
                        nextMaintenance.setDate(nextMaintenance.getDate() + 7);
                        nextMaintenance.setHours(parseInt(maintenanceConfig.startTime.split(':')[0]),
                            parseInt(maintenanceConfig.startTime.split(':')[1]), 0, 0);
                    }
                } else {
                    var daysUntilNext = (startDay - dayOfWeek + 7) % 7;
                    if (daysUntilNext === 0) daysUntilNext = 7;
                    nextMaintenance.setDate(nextMaintenance.getDate() + daysUntilNext);
                    nextMaintenance.setHours(parseInt(maintenanceConfig.startTime.split(':')[0]),
                        parseInt(maintenanceConfig.startTime.split(':')[1]), 0, 0);
                }

                return nextMaintenance;
            }

            /**
             * Update maintenance status display
             */
            function updateMaintenanceStatus() {
                $jQ = jQuery.noConflict();
                var underMaintenance = isMaintenanceWindow();
                // alert(underMaintenance);
                if (underMaintenance) {
                    $jQ('#maintenanceContainer').fadeIn();
                    // BOM upload will not be available from 2230 Saturdays to 0500 Sundays Central time
                    $jQ('#maintenanceLabel').text(
                        'Weekly scheduled maintenance is in progress (Every ' +
                        maintenanceConfig.startDay + ' ' + maintenanceConfig.startTime +
                        ' to ' + maintenanceConfig.endDay + ' ' + maintenanceConfig.endTime + '). ' +
                        'We will be back online soon.'
                    );

                    // var now = new Date();
                    $jQ('#maintenanceTime').text(
                        formatTime(getCurrentTimeInCentralTime())

                    );

                    if (underMaintenance) {
                        // Disable controls
                        $jQ("#btnGetBOMFromMapics").prop("disabled", true).val('Under maintenance');
                        // alert(underMaintenance);

                    }
                    else {
                        $jQ('#maintenanceContainer').fadeOut();
                        // Enable controls
                        $jQ("#btnGetBOMFromMapics").prop("disabled", false).val('Get BOM from XA');
                        // alert(underMaintenance);
                    }
                }
            }

            /**
             * Format time as readable string
             */
            function formatTime(date) {
                var daysOfWeek = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                var day = daysOfWeek[date.day]; //.getDay()
                var hours = String(date.hours).padStart(2, '0'); // .getHours()
                var minutes = String(date.minutes).padStart(2, '0');    // .getMinutes()
                var month = String(date.month + 1).padStart(2, '0');  // .getMonth()
                var dayOfMonth = String(date.dayOfMonth).padStart(2, '0'); // .getDate()

                return day + ', ' + month + '/' + dayOfMonth + ' at ' + hours + ':' + minutes;
            }

            /* Maintenance Configuration End */

        $jQ(document).ready(function () {
            // fromQueryString = N will pull default environment from cookie.
            fromQueryString = 'N';
            // Parent Item Number must be in UPPERCASE - case sensitive when validating XA BOM and data.
            $jQ("#txtItemNumber").on("input", function () {
                this.value = this.value.toUpperCase();
                // alert(document.getElementById('txtItemNumber').value);
            });

            /* maintenance settings */

            // Initial check
            updateMaintenanceStatus();

            // Check every minute
            setInterval(updateMaintenanceStatus, 60000);

            // Check every second (for demo, reduce to 60000ms for production)
            setInterval(function () {
                //var now = new Date();
                //var hours = String(now.getHours()).padStart(2, '0');
                //var minutes = String(now.getMinutes()).padStart(2, '0');
                //var seconds = String(now.getSeconds()).padStart(2, '0');

                if (isMaintenanceWindow()) {
                    $jQ('#maintenanceTime').text(
                        'Current time: ' + formatTime(getCurrentTimeInCentralTime())
                    );
                }
            }, 1000);

            /* maintenance settings end. */

            $jQ("#txtItemNumber").on("keypress", function (e) {
                if (e.which === 13) {
                    e.preventDefault(); GetBOMComponents();

                }
            });

            $jQ.ajax({
                type: "GET",
                url: "@Url.Action("GetAllEnvironments", "BOMUpload")",
                dataType: "json",   // it is important for Ajax call
                data: { fromQueryString: fromQueryString },
                success: function (data) {
                    var s;
                    var sdata = data.sort();
                    //var sdata = data.EnvironmentList.sort((a, b) => a.EnvironmentId.localeCompare(b.EnvironmentId));

                    for (var i = 0; i < sdata.length; i++) {
                        s += '<option value="' + sdata[i].EnvironmentCode + '">' + sdata[i].EnvironmentId + '</option>';
                    }
                    $jQ("#ddlEnv").html(s);

                    var cookieENV = GetEnvCookieText('EnvironmentCookie');
                    if (cookieENV)
                        SETDropDownByText("#ddlEnv", cookieENV);
                    else
                        SETDropDownByText("#ddlEnv", "FF-17");

                    // //alert('Index cookie|document.ready|GetAllEnvironments: document.cookie: ' + document.cookie + '\n\r' + $jQ("#ddlEnv option:selected").text());

                    if (qstrItmEnv != null)
                    {
                        //document.getElementById('ddlEnv').text = qstrItmEnv;
                        SETDropDownByText("#ddlEnv", qstrItmEnv);
                        document.getElementById('ddlEnv').disabled = true;
                        document.getElementById('txtItemNumber').disabled = true;
                        $jQ("#btnCheckItemExists").hide();
                        $jQ("#btnGetBOMFromMapics").hide();
                    }

                },
                error: function (xhr, status, error) {
                    // alert("Error loading document.ready.GetAllEnvironments:", error)
                    // console.error("Error loading environments:", error);
                }
            });


            }); // document ready call END.

        $jQ("body").on("change", "#ddlEnv",
            function () {
                    var selectedEnv = jQuery('#ddlEnv :selected').text();

                    // Set the cookie name and value
                    var cookieName = "EnvironmentCookie";
                    var cookieValue = "Environment=" + encodeURIComponent(selectedEnv);

                    setEnvCookie(cookieName, cookieValue, 60);
            });

        if (qstrItmNum != null && qstrItmEnv != null) {

            // // Set the cookie name and value NOT REQUIRED HERE 2025/SEP/22
            // // var cookieName = "EnvironmentCookie";
            // // var cookieValue = "Environment=" + encodeURIComponent(qstrItmEnv);

            // // setEnvCookie(cookieName, cookieValue, 60);

            getBOMsUsingQueryString();

        }

        // Assign values to itemnumber and environment from View UI.
        var itemNumber = document.getElementById('txtItemNumber').value;
        var environment = jQuery('#ddlEnv :selected').text();    //val();

        // List BOM using Query string parameters
        function getBOMsUsingQueryString() {
            if (qstrItmNum != null) {
                jQuery('#txtItemNumber').val(qstrItmNum);
                // alert('Index Item: ' + qstrItmNum);
            }

            if (qstrItmEnv != null) {
                if (qstrItmEnv      != environment) {
                    environment = qstrItmEnv;
                }
            }

            document.getElementById('btnGetBOMFromMapics').click();
        }

        function validateUserSequence(value, column) {

            if (value !== undefined) {
                var grid = $jQ("#BOMUploadGrid");

                // Get current row Id
                var selRowId = grid.jqGrid('getGridParam', 'selrow');
                var rowKey = jQuery("#BOMUploadGrid").jqGrid('getGridParam', 'selrow');
                var rowObject = jQuery('#BOMUploadGrid').getRowData(rowKey);

                var compItem = rowObject.ComponentItemNumber; // Gets the value from the selected row on grid.

                value = value.toString().padStart(4, '0');
                var varcomponentInGrid, varuserSequenceInGrid, i;

                //Get Index of selected Row
                var gridSelRowIndex = grid.jqGrid('getInd', selRowId);

                // Loop through the grid data to see for any duplicate record.
                // If component item and user sequence are repeated, alert user to fix it before proceeding to next step.
                var gridrows = jQuery("#BOMUploadGrid").getDataIDs();

                for (i = 0; i < gridrows.length; i++) {    // count
                    varcomponentInGrid = $jQ("#BOMUploadGrid").getCell(gridrows[i], "ComponentItemNumber");
                    varuserSequenceInGrid = $jQ("#BOMUploadGrid").getCell(gridrows[i], "UserSequence");

                    /* alert(gridSelRowIndex + ' == ' + (i + 1));    */
                    // Skip current editing row
                    // if ((i + 1) == gridSelRowIndex) continue;

                    if (varcomponentInGrid !== undefined && varuserSequenceInGrid !== undefined) {
                        if (value.toLowerCase() === varuserSequenceInGrid.toLowerCase() && compItem.toLowerCase() === varcomponentInGrid.toLowerCase() && gridSelRowIndex != (i + 1)) {
                            // alert('gridSelRowIndex: ' + gridSelRowIndex + '  i + 1: ' + (i + 1) + ' | ' + value.toLowerCase() + ' === ' + varuserSequenceInGrid.toLowerCase() + ' | ' + compItem.toLowerCase() + ' === ' + varcomponentInGrid.toLowerCase());
                            return [false, " *** The combination of User Sequence and Component Item already exist. Please select a different combination to proceed. ***"];
                        }
                    }
                }
            }
            return [true, ""];
        }

        // Child component is mandatory field while creating a new component to the BOM.
        // Also the same component item with same balloon cannot be repeated within the same BOM.
        function validateComponentItem(value, column) {
            if (value !== undefined) {
                if (value.trim() === '') {
                    return [false, "Child Component Item: Field is required"];
                }
                else {
                    var grid = $jQ("#BOMUploadGrid");

                    // Get current row Id
                    var selRowId = grid.jqGrid('getGridParam', 'selrow');
                    var userSeqId = "#" + selRowId + "_UserSequence";
                    var userSeq = document.querySelector(userSeqId).value;  // Gets the value from the selected row on grid.
                    userSeq = userSeq.toString().padStart(4, '0')

                    // If component item and user sequence are repeated, alert user to fix it before proceeding to next step.
                    var gridrows = jQuery("#BOMUploadGrid").getDataIDs();

                    var componentInGrid, userSequenceInGrid, i;

                    //Get Index of selected Row
                    var gridselrowIndex = grid.jqGrid('getInd', selRowId);

                    // Loop through the grid data to see for any duplicate record.
                    // If component item and user sequence are repeated, alert user to fix it before proceeding to next step.
                    for (i = 0; i < gridrows.length; i++) {
                        ////componentInGrid = listOfComponents[i];
                        ////userSequenceInGrid = listOfUserSequence[i];
                         componentInGrid = $jQ("#BOMUploadGrid").getCell(gridrows[i], "ComponentItemNumber");
                         userSequenceInGrid = $jQ("#BOMUploadGrid").getCell(gridrows[i], "UserSequence");

                        if (componentInGrid !== undefined && userSequenceInGrid !== undefined && gridselrowIndex != (i + 1)) {
                            if (value.toLowerCase() === componentInGrid.toLowerCase() && userSeq.toLowerCase() === userSequenceInGrid.toLowerCase()) {
                                return [false, "The combination of User Sequence and Component Item already exist. Please select a different combination to proceed !"];
                            }
                        }
                    }

                }
            }
            return [true, ""];
        }

