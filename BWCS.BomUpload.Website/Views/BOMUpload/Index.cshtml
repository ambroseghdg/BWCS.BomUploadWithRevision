@section scripts {
    <script type="text/javascript">

        var $jQ = jQuery.noConflict();
        const currentUrl = new URL(window.location.href);
        const params = currentUrl.searchParams;

        var qstrItmEnv = params.get('Env');
        var qstrItmNum = params.get('ParentItem');
        var LatestParentItemRevision;
        var strFinalParentItemRevision;
        // Parent Item Number must be in UPPERCASE - case sensitive when validating XA BOM and data.
        qstrItmNum = qstrItmNum ? qstrItmNum.toUpperCase() : "";

        var fromQueryString = 'N';
        $jQ("#lblNote").hide();

        // Currently used environments in the app are pulled from SQL master table.
        // Any addition to new environment will reflect in the dropdownlist automatically.

        function SETDropDownByText(ddlselector, text) {
            $jQ(ddlselector + " option").filter(function () {
                return $jQ(this).text() === text;
            }).prop("selected", true);
        }

        // helper: read cookie by name
        // if browser has document.cookie = "EnvironmentCookie=Environment=FF-BWIS; EnvironmentCookiePDM=EnvironmentPDM=QA-ENV";
        // call GetEnvCookieText("EnvironmentPDM"); TO return QA-ENV

        function GetEnvCookieText(nameKey) {
            var bomuploadcookies = document.cookie.split(";"); // split all cookies
            // alert('Index - doc. cookie: ' + document.cookie);
            for (var i = 0; i < bomuploadcookies.length; i++) {
                var eachcookie = bomuploadcookies[i].trim();
                if (eachcookie.indexOf(nameKey + "=") === 0) {
                    var rawCookie = eachcookie.substring(nameKey.length + 1);
                    // rawCookie = "EnvironmentPDM=FF-BWIS"

                    var idx = rawCookie.indexOf("=");
                    if (idx !== -1) {
                        return rawCookie.substring(idx + 1); // "FF-BWIS"
                    }
                    return rawCookie;
                }
            }
            return null;
        }

        /*
            |setCookie Usage:

            var cookieName = "EnvironmentCookie";
            var cookieValue = "Environment=" + encodeURIComponent(selectedEnv);
            setCookie(cookieName, cookieValue, 60);
        */

        function setEnvCookie(cookieName, cookieValue, days) {
            var expirationDate = new Date();
            expirationDate.setDate(expirationDate.getDate() + days);
            // alert('Index - setEnvCookie BEFORE document.cookie: ' + document.cookie);
            var cookieString = cookieName + "=" + cookieValue
                + "; expires=" + expirationDate.toUTCString()
                + "; path=/";
                // var cookieString = cookieName + "=" + cookieValue + "; expires=" + expirationDate.toUTCString() + "; path=/";
            document.cookie = cookieString;
            // alert('Index - setEnvCookie after: ' + document.cookie);
            }

            /* Maintenance Configuration Start */

            /**
             * Update maintenance status display
             */
            function updateMaintenanceStatus() {
                $jQ = jQuery.noConflict();
                var maintenanceWindowStatus = $jQ('#maintenanceWindowStatus').val() === 'true';
                // alert(underMaintenance);
                if (maintenanceWindowStatus) {
                    // Disable controls
                    $jQ("#btnGetBOMFromMapics").prop("disabled", true).val('Under maintenance');
                    // alert(underMaintenance);
                }
                else {
                         // Enable controls
                        $jQ("#btnGetBOMFromMapics").prop("disabled", false).val('Get BOM from XA');
                        // alert(underMaintenance);
                    }
            }

            /* Maintenance Configuration End */

        $jQ(document).ready(function () {
            // fromQueryString = N will pull default environment from cookie.
            fromQueryString = 'N';
            // Parent Item Number must be in UPPERCASE - case sensitive when validating XA BOM and data.
            $jQ("#txtItemNumber").on("input", function () {
                this.value = this.value.toUpperCase();
                // alert(document.getElementById('txtItemNumber').value);
            });

            /* maintenance settings */

            // Initial check
            updateMaintenanceStatus();

            /* maintenance settings end. */

            $jQ("#txtItemNumber").on("keypress", function (e) {
                if (e.which === 13) {
                    e.preventDefault(); GetBOMComponents();

                }
            });

            $jQ.ajax({
                type: "GET",
                url: "@Url.Action("GetAllEnvironments", "BOMUpload")",
                dataType: "json",   // it is important for Ajax call
                data: { fromQueryString: fromQueryString },
                success: function (data) {
                    var s;
                    var sdata = data.sort();
                    //var sdata = data.EnvironmentList.sort((a, b) => a.EnvironmentId.localeCompare(b.EnvironmentId));

                    for (var i = 0; i < sdata.length; i++) {
                        s += '<option value="' + sdata[i].EnvironmentCode + '">' + sdata[i].EnvironmentId + '</option>';
                    }
                    $jQ("#ddlEnv").html(s);

                    var cookieENV = GetEnvCookieText('EnvironmentCookie');
                    if (cookieENV)
                        SETDropDownByText("#ddlEnv", cookieENV);
                    else
                        SETDropDownByText("#ddlEnv", "FF-17");

                    // //alert('Index cookie|document.ready|GetAllEnvironments: document.cookie: ' + document.cookie + '\n\r' + $jQ("#ddlEnv option:selected").text());

                    if (qstrItmEnv != null)
                    {
                        //document.getElementById('ddlEnv').text = qstrItmEnv;
                        SETDropDownByText("#ddlEnv", qstrItmEnv);
                        document.getElementById('ddlEnv').disabled = true;
                        document.getElementById('txtItemNumber').disabled = true;
                        $jQ("#btnCheckItemExists").hide();
                        $jQ("#btnGetBOMFromMapics").hide();
                    }

                },
                error: function (xhr, status, error) {
                    // alert("Error loading document.ready.GetAllEnvironments:", error)
                    // console.error("Error loading environments:", error);
                }
            });


            }); // document ready call END.

        $jQ("body").on("change", "#ddlEnv",
            function () {
                    var selectedEnv = jQuery('#ddlEnv :selected').text();

                    // Set the cookie name and value
                    var cookieName = "EnvironmentCookie";
                    var cookieValue = "Environment=" + encodeURIComponent(selectedEnv);

                    setEnvCookie(cookieName, cookieValue, 60);
            });

        if (qstrItmNum != null && qstrItmEnv != null) {

            // // Set the cookie name and value NOT REQUIRED HERE 2025/SEP/22
            // // var cookieName = "EnvironmentCookie";
            // // var cookieValue = "Environment=" + encodeURIComponent(qstrItmEnv);

            // // setEnvCookie(cookieName, cookieValue, 60);

            getBOMsUsingQueryString();

        }

        // Assign values to itemnumber and environment from View UI.
        var itemNumber = document.getElementById('txtItemNumber').value;
        var environment = jQuery('#ddlEnv :selected').text();    //val();

        // List BOM using Query string parameters
        function getBOMsUsingQueryString() {
            if (qstrItmNum != null) {
                jQuery('#txtItemNumber').val(qstrItmNum);
                // alert('Index Item: ' + qstrItmNum);
            }

            if (qstrItmEnv != null) {
                if (qstrItmEnv      != environment) {
                    environment = qstrItmEnv;
                }
            }

            document.getElementById('btnGetBOMFromMapics').click();
        }

        function validateUserSequence(value, column) {

            if (value !== undefined) {
                var grid = $jQ("#BOMUploadGrid");

                // Get current row Id
                var selRowId = grid.jqGrid('getGridParam', 'selrow');
                var rowKey = jQuery("#BOMUploadGrid").jqGrid('getGridParam', 'selrow');
                var rowObject = jQuery('#BOMUploadGrid').getRowData(rowKey);

                var compItem = rowObject.ComponentItemNumber; // Gets the value from the selected row on grid.

                value = value.toString().padStart(4, '0');
                var varcomponentInGrid, varuserSequenceInGrid, i;

                //Get Index of selected Row
                var gridSelRowIndex = grid.jqGrid('getInd', selRowId);

                // Loop through the grid data to see for any duplicate record.
                // If component item and user sequence are repeated, alert user to fix it before proceeding to next step.
                var gridrows = jQuery("#BOMUploadGrid").getDataIDs();

                for (i = 0; i < gridrows.length; i++) {    // count
                    varcomponentInGrid = $jQ("#BOMUploadGrid").getCell(gridrows[i], "ComponentItemNumber");
                    varuserSequenceInGrid = $jQ("#BOMUploadGrid").getCell(gridrows[i], "UserSequence");

                    /* alert(gridSelRowIndex + ' == ' + (i + 1));    */
                    // Skip current editing row
                    // if ((i + 1) == gridSelRowIndex) continue;

                    if (varcomponentInGrid !== undefined && varuserSequenceInGrid !== undefined) {
                        if (value.toLowerCase() === varuserSequenceInGrid.toLowerCase() && compItem.toLowerCase() === varcomponentInGrid.toLowerCase() && gridSelRowIndex != (i + 1)) {
                            // alert('gridSelRowIndex: ' + gridSelRowIndex + '  i + 1: ' + (i + 1) + ' | ' + value.toLowerCase() + ' === ' + varuserSequenceInGrid.toLowerCase() + ' | ' + compItem.toLowerCase() + ' === ' + varcomponentInGrid.toLowerCase());
                            return [false, " *** The combination of User Sequence and Component Item already exist. Please select a different combination to proceed. ***"];
                        }
                    }
                }
            }
            return [true, ""];
        }

        // Child component is mandatory field while creating a new component to the BOM.
        // Also the same component item with same balloon cannot be repeated within the same BOM.
        function validateComponentItem(value, column) {
            if (value !== undefined) {
                if (value.trim() === '') {
                    return [false, "Child Component Item: Field is required"];
                }
                else {
                    var grid = $jQ("#BOMUploadGrid");

                    // Get current row Id
                    var selRowId = grid.jqGrid('getGridParam', 'selrow');
                    var userSeqId = "#" + selRowId + "_UserSequence";
                    var userSeq = document.querySelector(userSeqId).value;  // Gets the value from the selected row on grid.
                    userSeq = userSeq.toString().padStart(4, '0')

                    // If component item and user sequence are repeated, alert user to fix it before proceeding to next step.
                    var gridrows = jQuery("#BOMUploadGrid").getDataIDs();

                    var componentInGrid, userSequenceInGrid, i;

                    //Get Index of selected Row
                    var gridselrowIndex = grid.jqGrid('getInd', selRowId);

                    // Loop through the grid data to see for any duplicate record.
                    // If component item and user sequence are repeated, alert user to fix it before proceeding to next step.
                    for (i = 0; i < gridrows.length; i++) {
                        ////componentInGrid = listOfComponents[i];
                        ////userSequenceInGrid = listOfUserSequence[i];
                         componentInGrid = $jQ("#BOMUploadGrid").getCell(gridrows[i], "ComponentItemNumber");
                         userSequenceInGrid = $jQ("#BOMUploadGrid").getCell(gridrows[i], "UserSequence");

                        if (componentInGrid !== undefined && userSequenceInGrid !== undefined && gridselrowIndex != (i + 1)) {
                            if (value.toLowerCase() === componentInGrid.toLowerCase() && userSeq.toLowerCase() === userSequenceInGrid.toLowerCase()) {
                                return [false, "The combination of User Sequence and Component Item already exist. Please select a different combination to proceed !"];
                            }
                        }
                    }

                }
            }
            return [true, ""];
        }

        // Check whether Item exists in XA or Not. If does not exist, alert user, no record.
        function CheckItemExists() {
            $jQ.blockUI({
                message: '<img src="../Images/PageLoader.gif" />',
                css: {
                    border: 'none',
                    backgroundColor: 'none',
                    opacity: .7
                }
            });
            var ValidateResult = true;
            var itemNum = jQuery("#txtItemNumber").val()
            if (itemNum == "") {
                alert("Please Enter Item Number to proceed!");
                ValidateResult = false;
                $jQ.unblockUI();
            }

            if (ValidateResult == true) {
                // // // jQuery('#BOMUploadGrid').jqGrid('clearGridData'); it not required and performed while reloadgrid data.
                var itemNumber = document.getElementById('txtItemNumber').value;
                var environment = jQuery('#ddlEnv :selected').text();
                var site = jQuery('#ddlEnv :selected').val();

                if (qstrItmEnv != null) {
                    if (qstrItmEnv != environment) {
                        environment = qstrItmEnv;
                    }
                }

                strFinalParentItemRevision = "GetLatestRevision";

                jQuery.ajax({
                    url: "/BOMUpload/CheckItemExistence",
                    type: 'POST',
                    data: JSON.stringify({ itemNumber: itemNumber, environment: environment, site: site, qsStrParentItemRevision: strFinalParentItemRevision}),
                    datatype: "json",
                    contentType: 'application/json',
                    success: function (response) {
                        $jQ.unblockUI();
                        var itemNumber1 = response[0].ItemNumber;
                        var description = response[0].ItemDescription;
                        var completeDescription = response[0].CompleteDescription;
                        var drawingNumber = response[0].DrawingNumber;

                        if (itemNumber1 == "") {
                            alert("Item " + itemNumber + " does not exist in environment: " + environment);
                            $jQ('#txtItemNumber').html("");
                            $jQ('#lblDescriptionValue').html("");
                            $jQ('#lblDrawingNumberValue').html("");
                            $jQ('#lblDescriptionValue').hide();
                            $jQ('#lblDrawingNumberValue').hide();
                            $jQ("#BOMUploadGrid").hide();
                        }
                        else {
                            $jQ('#lblDescriptionValue').html(description);
                            $jQ('#lblDrawingNumberValue').html(drawingNumber);
                            SETDropDownByText("#ddlEnv", qstrItmEnv);
                            $jQ('#lblDescriptionValue').show();
                            $jQ('#lblDrawingNumberValue').show();

                            const $lbl = $jQ('#lblDescriptionValue');
                            const hasError = $lbl.text().toLowerCase().includes('systemlink service call error');

                            if (hasError) {
                                $lbl.css('background-color', 'yellow');
                            } else {
                                $lbl.css('background-color', '');
                            }

                            CheckItemHeaderExists();
                        }
                    },
                    error: function (result) {
                        $jQ.unblockUI();
                    }
                });
            }
        }

        // Check whether Item HEADER exists in XA or Not. If does not exist, alert user, no record.
        function CheckItemHeaderExists() {
            $jQ.blockUI({
                message: '<img src="../Images/PageLoader.gif" />',
                css: {
                    border: 'none',
                    backgroundColor: 'none',
                    opacity: .7
                }
            });
            var ValidateResult = true;
            var itemNum = jQuery("#txtItemNumber").val()
            if (itemNum == "") {
                alert("Please Enter Item Number to proceed!");
                ValidateResult = false;
                $jQ.unblockUI();
            }

            if (ValidateResult == true) {
                // // // jQuery('#BOMUploadGrid').jqGrid('clearGridData'); it not required and performed while reloadgrid data.
                var itemNumber = document.getElementById('txtItemNumber').value;
                var environment = jQuery('#ddlEnv :selected').text();
                var site = jQuery('#ddlEnv :selected').val();

                if (qstrItmEnv != null) {
                    if (qstrItmEnv != environment) {
                        environment = qstrItmEnv;
                    }
                }

                strFinalParentItemRevision = "GetLatestRevision";

                jQuery.ajax({
                    url: "/BOMUpload/IsVaildHeaderParentItem",
                    type: 'POST',
                    data: JSON.stringify({ itemNumber: itemNumber, environment: environment, site: site, qsStrParentItemRevision: strFinalParentItemRevision }),
                    datatype: "json",
                    contentType: 'application/json',
                    success: function (response) {
                        $jQ.unblockUI();
                        var itemNumber1 = response[0].ItemNumber;
                        var description = response[0].ItemDescription;
                        var completeDescription = response[0].CompleteDescription;
                        var drawingNumber = response[0].DrawingNumber;
                        var ITTYP = response[0].ItemType;

                        if (['0', '1', '2', '9'].indexOf(ITTYP) == -1) {
                            alert("XA Error: Item " + itemNumber + " ( Item Type " + ITTYP + " ) cannot have a BOM. Only Types 0, 1, 2, and 9 can have BOMs. Please change the item type using the NICe tool.");
                            $jQ('#lblDescriptionValue').html("");
                            $jQ('#lblDrawingNumberValue').html("");
                            $jQ('#lblDescriptionValue').hide();
                            $jQ('#lblDrawingNumberValue').hide();
                            $jQ("#BOMUploadGrid").hide();
                            $jQ('#lblNoDataMessage').html("XA Error: Item " + itemNumber + " ( Item Type " + ITTYP + " ) cannot have a BOM. Only Types 0, 1, 2, and 9 can have BOMs. Please change the item type using the NICe tool.");
                        }
                        else {
                            $jQ('#lblDescriptionValue').html(description);
                            $jQ('#lblDrawingNumberValue').html(drawingNumber);

                            $jQ('#lblDescriptionValue').show();
                            $jQ('#lblDrawingNumberValue').show();
                            $jQ('#lblNoDataMessage').html("");

                            // it will show error notification to User
                            if (userNoteMessage !== null &&
                                userNoteMessage !== undefined) {
                                if (userNoteMessage.length > 0) $jQ('#lblNoDataMessage').html(userNoteMessage);
                            }
                        }
                    },
                    error: function (result) {
                        $jQ.unblockUI();
                    }
                });
            }
        }

        // Check GetParentItemRevisionByParentItemSite
        function GetLatestParentItemRevisionByParentItemSite() {
            $jQ.blockUI({
                message: '<img src="../Images/PageLoader.gif" />',
                css: {
                    border: 'none',
                    backgroundColor: 'none',
                    opacity: .7
                }
            });

            var ValidateResult = true;
            var itemNum = jQuery("#txtItemNumber").val()
            if (itemNum == "") {
                alert("Please Enter Item Number to proceed!");
                ValidateResult = false;
                $jQ.unblockUI();
            }

            if (ValidateResult == true) {

                var itemNumber = document.getElementById('txtItemNumber').value;
                var environment = jQuery('#ddlEnv :selected').text();
                var site = jQuery('#ddlEnv :selected').val();

                if (qstrItmEnv != null) {
                    if (qstrItmEnv != environment) {
                        environment = qstrItmEnv;
                    }
                }

                // Get latest Parent Item Revision using POST Start
                // url: "/BOMUpload/GetParentItemRevisionByParentItemSite",
                jQuery.ajax({
                    url: '@Url.Action("GetParentItemRevisionByParentItemSite", "BOMUpload")',
                    type: 'POST',
                    data: JSON.stringify({ itemNumber: itemNumber, environment: environment, site: site }),
                    datatype: "json",
                    contentType: 'application/json',
                    success: function (response) {
                        $jQ.unblockUI();
                        var itemNumber1 = response[0].ItemNumber;
                        var description = response[0].ItemDescription;
                        var completeDescription = response[0].CompleteDescription;
                        var drawingNumber = response[0].DrawingNumber;
                        LatestParentItemRevision = response[0].ParentItemRevision;
                        // alert("GetLatestParentItemRevisionByParentItemSite:::" + LatestParentItemRevision);
                        if (itemNumber1 == "") {
                            alert("GetParentItemRevisionByParentItemSite | Item " + itemNumber + " does not exist in environment: " + environment);
                            $jQ('#txtItemNumber').html("");
                            $jQ('#lblDescriptionValue').html("");
                            $jQ('#lblDrawingNumberValue').html("");
                            $jQ('#lblDescriptionValue').hide();
                            $jQ('#lblDrawingNumberValue').hide();
                            $jQ("#BOMUploadGrid").hide();
                        }
                        else {
                            //$jQ('#lblDescriptionValue').html(description);
                            //$jQ('#lblDrawingNumberValue').html(drawingNumber);
                            //SETDropDownByText("#ddlEnv", qstrItmEnv);
                            //$jQ('#lblDescriptionValue').show();
                            //$jQ('#lblDrawingNumberValue').show();

                            const $lbl = $jQ('#lblDescriptionValue');
                            const hasError = $lbl.text().toLowerCase().includes('systemlink service call error');

                            if (hasError) {
                                $lbl.css('background-color', 'yellow');
                            } else {
                                $lbl.css('background-color', '');
                            }
                        }
                    },
                    error: function (result) {
                        $jQ.unblockUI();
                    }
                });

                // Get latest Parent Item Revision END
            }
        }

