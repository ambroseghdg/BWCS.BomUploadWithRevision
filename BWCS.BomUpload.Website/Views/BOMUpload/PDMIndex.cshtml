@section scripts {
    <script type="text/javascript">

        var $jQ = jQuery.noConflict();
        // use comma separated paremeters in Global var
        var BOMData = { HasParentItemRevisionInput : false };

        const currentUrl = new URL(window.location.href);
        const params = currentUrl.searchParams;

        var qstrItmNum = params.get('ParentItem');
        // Parent Item Number must be in UPPERCASE - case sensitive when validating XA BOM and data.
        qstrItmNum = qstrItmNum ? qstrItmNum.toUpperCase() : "";
        // // qstrItmNum = qstrItmNum ? decodeURIComponent(qstrItmNum) : ""; // Decode the item number if it exists, otherwise set to null

        var qstrReadFrom = params.get('ReadFrom');
        // //const urlParams = new URLSearchParams(window.location.search);
        var urlSQLParentItemRevision = params.get('ParentItemRevision');
        const UrlHasSQLParentItemRevision = params.has('ParentItemRevision');

        var txtParentItemRevisionText = document.getElementById('txtParentItemRevision').value;
        txtParentItemRevisionText = txtParentItemRevisionText.trim();

        var chkLatestRevisionVal = "";
        var isGetLatestRevChecked;

        var strFinalParentItemRevision = "";

        // This revision flag value will be used when calling XA to retrieve the BOM, rather than relying only on the revision returned from XA.
        if ($jQ("#chkGetLatestRevision").is(":checked")) {
            isGetLatestRevChecked = true;
        }
        else
        {
            isGetLatestRevChecked = false;
        }

        function SETDropDownByText(ddlselector, text) {
            $jQ(ddlselector + " option").filter(function () {
                return $jQ(this).text() === text;
            }).prop("selected", true);
        }

        //$jQ('#chktoggleBalloonRows').attr('checked', false); // Unchecks it

        // fromQueryString = Y will pull default environment from cookie.
        var fromQueryString = 'Y';

        // helper: read cookie by name
        // if browser has document.cookie = "EnvironmentCookie=Environment=FF-BWIS; EnvironmentCookiePDM=EnvironmentPDM=QA-ENV";
        // call GetEnvCookieText("EnvironmentPDM"); TO return QA-ENV

        function GetEnvCookieText(nameKey) {
            var bomuploadcookies = document.cookie.split(";"); // split all cookies
            // alert('PDMIndex - doc. cookie: ' + document.cookie);
            for (var i = 0; i < bomuploadcookies.length; i++) {
                var eachcookie = bomuploadcookies[i].trim();
                if (eachcookie.indexOf(nameKey + "=") === 0) {
                    var rawCookie = eachcookie.substring(nameKey.length + 1);
                    // rawCookie = "EnvironmentPDM=FF-BWIS"

                    var idx = rawCookie.indexOf("=");
                    if (idx !== -1) {
                        return rawCookie.substring(idx + 1); // "FF-BWIS"
                    }
                    return rawCookie;
                }
            }
            return null;
        }

        /*
            |setCookie Usage:

            var cookieName = "EnvironmentCookiePDM";
            var cookieValue = "EnvironmentPDM=" + encodeURIComponent(selectedEnv);
            setCookie(cookieName, cookieValue, 60);
        */

        function setEnvCookie(cookieName, cookieValue, days) {
            var expirationDate = new Date();
            expirationDate.setDate(expirationDate.getDate() + days);
            // alert('PDM Index - setEnvCookie BEFORE: ' + document.cookie);
            var cookieString = cookieName + "=" + cookieValue
                + "; expires=" + expirationDate.toUTCString()
                + "; path=/";
                // var cookieString = cookieName + "=" + cookieValue + "; expires=" + expirationDate.toUTCString() + "; path=/";
            document.cookie = cookieString;
            // alert('PDM Index - setEnvCookie after: ' + document.cookie);
        }

        /* Maintenance Configuration Start */

        var maintenanceConfig = {
            startDay: 'Saturday',      // Saturday
            startTime: '21:12',        // 22:30 (10:30 PM)
            endDay: 'Saturday',          // Sunday
            endTime: '21:15',          // 05:00 (5:00 AM)
            timeZone: 'America/Chicago' // Central Time
        };

        //var maintenanceConfig = {
        //    startDay: 'Saturday',      // Saturday
        //    startTime: '22:30',        // 22:30 (10:30 PM)
        //    endDay: 'Sunday',          // Sunday
        //    endTime: '05:00',          // 05:00 (5:00 AM)
        //    timeZone: 'America/Chicago' // Central Time
        //};

        /**
 * Parse time string "HH:MM" to minutes
 * param {string} timeString - Time in format "HH:MM"
 * returns {number} Total minutes
 */
function parseTimeToMinutes(timeString) {
    try {
        var parts = timeString.split(':');
        var hours = parseInt(parts[0], 10);
        var minutes = parseInt(parts[1], 10);

        if (isNaN(hours) || isNaN(minutes)) {
            console.error('Invalid time format: ' + timeString);
            return 0;
        }

        return hours * 60 + minutes;
    } catch (error) {
        console.error('Error parsing time:', error);
        return 0;
    }
}

/**
 * Get day number from day name
 * param {string} dayName - Day name (e.g., "Saturday", "Sunday")
 * returns { number } Day of week(0 = Sunday, 6 = Saturday) 
 */
function getDayNumber(dayName) {
    var days = {
        'Sunday': 0,
        'Monday': 1,
        'Tuesday': 2,
        'Wednesday': 3,
        'Thursday': 4,
        'Friday': 5,
        'Saturday': 6
    };

    return days[dayName] !== undefined ? days[dayName] : -1;
}

        /*
         * Check if current time is within maintenance window
         * Saturday 22:30 to Sunday 05:00 Central Time
         */
        function isMaintenanceWindow() {
            try {
                // Parse times from config
                var maintenanceStartTime = parseTimeToMinutes(maintenanceConfig.startTime);
                var maintenanceEndTime = parseTimeToMinutes(maintenanceConfig.endTime);
                var startDay = getDayNumber(maintenanceConfig.startDay);
                var endDay = getDayNumber(maintenanceConfig.endDay);

                // Get current time
                var now = new Date();
                var currentDay = now.getDay();
                var currentTime = now.getHours() * 60 + now.getMinutes();

                // Log for debugging
                console.log('=== Maintenance Window Check ===');
                console.log('Config Start: ' + maintenanceConfig.startDay + ' ' + maintenanceConfig.startTime + ' (Day: ' + startDay + ', Time: ' + maintenanceStartTime + 'min)');
                console.log('Config End: ' + maintenanceConfig.endDay + ' ' + maintenanceConfig.endTime + ' (Day: ' + endDay + ', Time: ' + maintenanceEndTime + 'min)');
                console.log('Current: Day ' + currentDay + ', Time ' + currentTime + 'min (' + now.getHours() + ':' + String(now.getMinutes()).padStart(2, '0') + ')');

                // CASE 1: Same day maintenance (e.g., Saturday 05:55 to Saturday 06:50)
                if (startDay === endDay) {
                    console.log('✓ Same-day maintenance window');

                    if (currentDay === startDay &&
                        currentTime >= maintenanceStartTime &&
                        currentTime < maintenanceEndTime) {

                        console.log('✓ MAINTENANCE ACTIVE (Same-day window)');
                        return true;
                    }
                }
                // CASE 2: Multi-day maintenance (e.g., Saturday 22:30 to Sunday 05:00)
                else {
                    console.log('✓ Multi-day maintenance window');

                    // Check if start day and time >= start time
                    if (currentDay === startDay && currentTime >= maintenanceStartTime) {
                        console.log('✓ Maintenance Active: Start Window');
                        return true;
                    }

                    // Check if end day and time < end time
                    if (currentDay === endDay && currentTime < maintenanceEndTime) {
                        console.log('✓ Maintenance Active: End Window');
                        return true;
                    }
                }

                //// Check if start day and time >= start time
                //if (currentDay === startDay && currentTime >= maintenanceStartTime) {
                //    console.log('✓ Maintenance Active: Start Window');
                //    return true;
                //}

                //// Check if end day and time < end time
                //if (currentDay === endDay && currentTime < maintenanceEndTime) {
                //    console.log('✓ Maintenance Active: End Window');
                //    return true;
                //}

                console.log('✗ Maintenance Not Active');
                return false;
            } catch (error) {
                console.error('Error checking maintenance window:', error);
                return false;
            }
        }

        /**
          * Get next maintenance time
          */
        function getNextMaintenanceTime() {
            var now = new Date();
            var startDay = getDayNumber(maintenanceConfig.startDay);
            var dayOfWeek = now.getDay();
            var maintenanceStartTime = parseTimeToMinutes(maintenanceConfig.startTime);
            var currentTime = now.getHours() * 60 + now.getMinutes();

            var nextMaintenance = new Date(now);

            if (dayOfWeek === startDay) {
                if (currentTime < maintenanceStartTime) {
                    nextMaintenance.setHours(parseInt(maintenanceConfig.startTime.split(':')[0]),
                        parseInt(maintenanceConfig.startTime.split(':')[1]), 0, 0);
                } else {
                    nextMaintenance.setDate(nextMaintenance.getDate() + 7);
                    nextMaintenance.setHours(parseInt(maintenanceConfig.startTime.split(':')[0]),
                        parseInt(maintenanceConfig.startTime.split(':')[1]), 0, 0);
                }
            } else {
                var daysUntilNext = (startDay - dayOfWeek + 7) % 7;
                if (daysUntilNext === 0) daysUntilNext = 7;
                nextMaintenance.setDate(nextMaintenance.getDate() + daysUntilNext);
                nextMaintenance.setHours(parseInt(maintenanceConfig.startTime.split(':')[0]),
                    parseInt(maintenanceConfig.startTime.split(':')[1]), 0, 0);
            }

            return nextMaintenance;
        }

        /**
         * Update maintenance status display
         */
        function updateMaintenanceStatus() {
            $jQ = jQuery.noConflict(); 
            var underMaintenance = isMaintenanceWindow();
            // alert(underMaintenance);
            if (underMaintenance) {
                $jQ('#maintenanceContainer').fadeIn();
                // BOM upload will not be available from 2230 Saturdays to 0500 Sundays Central time
                $jQ('#maintenanceLabel').text(
                    'Weekly scheduled maintenance is in progress (Every ' +
                    maintenanceConfig.startDay + ' ' + maintenanceConfig.startTime +
                    ' to ' + maintenanceConfig.endDay + ' ' + maintenanceConfig.endTime + '). ' +
                    'We will be back online soon.'
                );

                var now = new Date();
                $jQ('#maintenanceTime').text(
                    formatTime(now)
                    //'Current time: ' + String(now.getHours()).padStart(2, '0') + ':' +
                    //String(now.getMinutes()).padStart(2, '0') + ':' +
                    //String(now.getSeconds()).padStart(2, '0')
                );

                if (underMaintenance) {
                    // Disable controls
                    $jQ("#btnUploadBomToXA").prop("disabled", true); // .text('Upload BOM to XA');
                }
                else {
                    $jQ('#maintenanceContainer').fadeOut();  
                    // Enable controls
                    $jQ("#btnUploadBomToXA").prop("disabled", false); // .text('Save');
                }
            }
        }

        /**
         * Format time as readable string
         */
        function formatTime(date) {
            var daysOfWeek = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
            var day = daysOfWeek[date.getDay()];
            var hours = String(date.getHours()).padStart(2, '0');
            var minutes = String(date.getMinutes()).padStart(2, '0');
            var month = String(date.getMonth() + 1).padStart(2, '0');
            var dayOfMonth = String(date.getDate()).padStart(2, '0');

            return day + ', ' + month + '/' + dayOfMonth + ' at ' + hours + ':' + minutes;
        }

       /* Maintenance Configuration End */

    $jQ("body").on("change", "#ddlEnv",
        function () {
            if (qstrItmNum != null) {

                var selectedEnv = jQuery('#ddlEnv :selected').text();

                // Set the cookie name and value
                var cookieName = "EnvironmentCookiePDM";
                var cookieValue = "EnvironmentPDM=" + encodeURIComponent(selectedEnv);

                setEnvCookie(cookieName, cookieValue, 60);

                // alert("ENV Change: " + selectedEnv);
                // alert(document.cookie);
                // // RefreshAllEnvironmentsWhileChoseEnvVal();
                getBOMsFromSQL();
            }
        });

        $jQ("#chktoggleBalloonRows").change(function () {
            ToggleBOMGridRowsVisibilityByBalloonChgs();
        });

        //function ToggleBOMGridRowsVisibilityByBalloonChgs() { }
        function ToggleBOMGridRowsVisibilityByBalloonChgs() {
            var boolshowOnlyBalloon = $jQ("#chktoggleBalloonRows").is(":checked");
            var allRowIds = $jQ("#BOMUploadGrid").jqGrid('getDataIDs');
            var intBalloonCnt = 0;

            // Create a lookup for "Balloon does not exist in XA" by key
            var BalloonMap = {};

            for (var i = 0; i < allRowIds.length; i++) {
                var rowId = allRowIds[i];
                var rowData = $jQ("#BOMUploadGrid").jqGrid('getRowData', rowId);
                if (rowData.Note === "Balloon # differs, but ITNBR and QTY match")
                {   // OLD Note: Balloon does not exist in XA
                    // Combine criteria to a key
                    var key = "|" + rowData.ComponentItemNumber + "|" + rowData.Qty ;    // not need: rowData.UserSequence +
                    BalloonMap[key] = true;
                }
            }

            // Handle visibility based on Note
            for (var i = 0; i < allRowIds.length; i++) {
                var rowId = allRowIds[i];
                var rowData = $jQ("#BOMUploadGrid").jqGrid('getRowData', rowId);
                var partNote = rowData.Note;
                var partBalloon = rowData.UserSequence;
                var partChildItemNo = rowData.ComponentItemNumber;
                var partQty = rowData.Qty;
                var partAction = rowData.Action;
                // alert("partAction: " + partAction);
                // If boolshowOnlyBalloon is false, we apply hiding criteria
                if (!boolshowOnlyBalloon) {
                    if (partNote === "Balloon # differs, but ITNBR and QTY match") {
                        intBalloonCnt++;
                        $jQ("#" + rowId, "#BOMUploadGrid").hide();
                        $jQ("#chktoggleBalloonRows").prop("disabled", false);
                    }
                    else if (partAction === "Delete")
                    {
                        // check if matching "balloon does not exist in xa" row exists
                        var key = "|" + partChildItemNo + "|" + partQty ;
                        // var key = partBalloon
                        // alert("balloon: " + BalloonMap[key]);
                        if (BalloonMap[key]) {
                            // hide this row
                            $jQ("#" + rowId, "#BOMUploadGrid").hide();
                            $jQ("#chktoggleBalloonRows").prop("disabled", false);
                        } else {
                            $jQ("#" + rowId, "#BOMUploadGrid").show();
                            //$jQ("#chktoggleBalloonRows").prop("disabled", true);
                        }
                    }
                        else {
                        $jQ("#" + rowId, "#BOMUploadGrid").show();
                        //$jQ("#chktoggleBalloonRows").prop("disabled", true);
                    }
                } else { // show all if boolshowOnlyBalloon is true
                    $jQ("#" + rowId, "#BOMUploadGrid").show();
                }

            }
            if (intBalloonCnt > 0) {
                $jQ("#lblNoOfBalloonChgs").html(" Upload [ " + intBalloonCnt.toString() + " ] Balloon(s) to XA.");
            }
            else {
                $jQ("#lblNoOfBalloonChgs").html("");
            }
        }

        // Currently used environments in the app are pulled from SQL master table.
        // Any addition to new environment will reflect in the dropdown list automatically.
        $jQ(document).ready(function () {

            //const urlpars = new URLSearchParams(window.location.search);
            //var urlstrParentItemRevision = urlpars.get("ParentItemRevision");

            $jQ.ajax({
                type: "GET",
                url: "/BOMUpload/GetAllEnvironments",
                data: { fromQueryString: fromQueryString, urlParentItemRevision: urlSQLParentItemRevision },
                success: function (data) {
                    var s="";
                    var sdata = data.sort();
                    // var sdata = data.EnvironmentList.sort((a, b) => a.EnvironmentId.localeCompare(b.EnvironmentId));

                    for (var i = 0; i < sdata.length; i++) {
                        s += '<option value="' + sdata[i].EnvironmentCode + '">' + sdata[i].EnvironmentId + '</option>';
                    }
                    $jQ("#ddlEnv").html(s);

                    var cookiepdmENV = GetEnvCookieText('EnvironmentCookiePDM');
                    if (cookiepdmENV) SETDropDownByText("#ddlEnv", cookiepdmENV);
                    // alert('PDMIndex cookie|ready|GetAllEnvironments: document.cookie: ' + document.cookie + '\n\r' + $jQ("#ddlEnv option:selected").text());

                    if (qstrItmNum != null) {
                        // alert("CheckItemExistence:  " + document.getElementById('ddlEnv').text);
                        getBOMsFromSQL();
                    }

                    ToggleBOMGridRowsVisibilityByBalloonChgs();
                }

            });

            /* maintenance settings */

            // Initial check
            updateMaintenanceStatus();

            // Check every minute
            setInterval(updateMaintenanceStatus, 60000);

            // Check every second (for demo, reduce to 60000ms for production)
            setInterval(function () {
                var now = new Date();
                //var hours = String(now.getHours()).padStart(2, '0');
                //var minutes = String(now.getMinutes()).padStart(2, '0');
