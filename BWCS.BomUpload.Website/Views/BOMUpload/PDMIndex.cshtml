        // Check whether Item exists in XA or Not. If does not exist, alert user, no record.
        function CheckItemExists() {
            $jQ.blockUI({
                message: '<img src="../Images/PageLoader.gif" />',
                css: {
                    border: 'none',
                    backgroundColor: 'none',
                    opacity: .7
                }
            });

            txtParentItemRevisionText = document.getElementById('txtParentItemRevision').value.trim();

            var ValidateResult = true;
            var itemNum = jQuery("#txtItemNumber").val()
            if (itemNum == "") {
                alert("Please Enter Item Number to proceed!");
                ValidateResult = false;
                $jQ.unblockUI();
            }

            if (ValidateResult == true) {
                var itemNumber = document.getElementById('txtItemNumber').value;
                var environment = jQuery('#ddlEnv :selected').text();
                var site = jQuery('#ddlEnv :selected').val();

                //if Get Latest check box not checked and get the latest revision number thru systemlink call from XA
                if ( !UrlHasSQLParentItemRevision) strFinalParentItemRevision = "GetLatestRevision";

                if ( UrlHasSQLParentItemRevision )
                {
                    strFinalParentItemRevision = urlSQLParentItemRevision;
                }

                if (BOMData.HasParentItemRevisionInput && !isGetLatestRevChecked)
                {
                    strFinalParentItemRevision = txtParentItemRevisionText;
                    // alert("CheckItemExists + HasParentItemRevisionInput | " + strFinalParentItemRevision + "| input selected: " + BOMData.HasParentItemRevisionInput);
                }

                if (BOMData.HasParentItemRevisionInput && isGetLatestRevChecked) strFinalParentItemRevision = "GetLatestRevision";

                /*jQuery('#BOMUploadGrid').jqGrid('clearGridData');*/

                jQuery.ajax({
                    url: "/BOMUpload/CheckItemExistence",
                    type: 'POST',
                    data: JSON.stringify({ itemNumber: itemNumber, environment: environment, site: site, qsStrParentItemRevision: strFinalParentItemRevision, fromQueryString: fromQueryString }),
                    datatype: "json",
                    contentType: 'application/json',
                    success: function (response) {
                        $jQ.unblockUI();
                        var itemNumber1 = response[0].ItemNumber;
                        var description = response[0].ItemDescription;
                        var completeDescription = response[0].CompleteDescription;
                        var drawingNumber = response[0].DrawingNumber;
                        var LatestParentItemRevision = response[0].ParentItemRevision

                        if (itemNumber1 == "") {
                            alert("Item " + itemNumber + " does not exist in environment: " + environment);
                            $jQ('#txtItemNumber').html("");
                            $jQ('#lblDescriptionValue').html("");
                            $jQ('#lblDrawingNumberValue').html("");
                            $jQ('#lblDescriptionValue').hide();
                            $jQ('#lblDrawingNumberValue').hide();
                            $jQ("#BOMUploadGrid").hide();
                            //return false;
                        }
                        else {
                            $jQ('#lblDescriptionValue').html(description);
                            $jQ('#lblDrawingNumberValue').html(drawingNumber);
                            $jQ('#txtItemNumber').html(itemNumber);
                            $jQ('#lblDescriptionValue').show();
                            $jQ('#lblDrawingNumberValue').show();
                            $jQ('#txtItemNumber').show();

                            $jQ('#lbltxtParentItemRevisionText').html(LatestParentItemRevision);

                            if( isGetLatestRevChecked )
                                $jQ('#txtParentItemRevision').val(LatestParentItemRevision);

                            CheckItemHeaderExists();
                            //return true;
                        }
                    },
                    error: function (result) {
                        $jQ.unblockUI();
                    }
                });
            }
        }

        // Check whether Item HEADER exists in XA or Not. If does not exist, alert user, no record.
        function CheckItemHeaderExists() {
            $jQ.blockUI({
                message: '<img src="../Images/PageLoader.gif" />',
                css: {
                    border: 'none',
                    backgroundColor: 'none',
                    opacity: .7
                }
            });

            txtParentItemRevisionText = document.getElementById('txtParentItemRevision').value.trim();

            var ValidateResult = true;
            var itemNum = jQuery("#txtItemNumber").val()
            if (itemNum == "") {
                alert("Please Enter Item Number to proceed!");
                ValidateResult = false;
                $jQ.unblockUI();
            }

            if (ValidateResult == true) {
                /*jQuery('#BOMUploadGrid').jqGrid('clearGridData');*/
                var itemNumber = document.getElementById('txtItemNumber').value;
                var environment = jQuery('#ddlEnv :selected').text();
                var site = jQuery('#ddlEnv :selected').val();

                //if Get Latest check box not checked and get the latest revision number thru systemlink call from XA
                if (!UrlHasSQLParentItemRevision) strFinalParentItemRevision = "GetLatestRevision";

                if (UrlHasSQLParentItemRevision) {
                    strFinalParentItemRevision = urlSQLParentItemRevision;
                }

                if (BOMData.HasParentItemRevisionInput && !isGetLatestRevChecked) {
                    strFinalParentItemRevision = txtParentItemRevisionText;
                }

                if (BOMData.HasParentItemRevisionInput && isGetLatestRevChecked) strFinalParentItemRevision = "GetLatestRevision";

                //alert("IsVaildHeaderParentItem: TRUE | " + strFinalParentItemRevision);

                jQuery.ajax({
                    url: "/BOMUpload/IsVaildHeaderParentItem",
                    type: 'POST',
                    data: JSON.stringify({ itemNumber: itemNumber, environment: environment, site: site, qsStrParentItemRevision: strFinalParentItemRevision }),
                    datatype: "json",
                    contentType: 'application/json',
                    success: function (response) {
                        $jQ.unblockUI();
                        var itemNumber1 = response[0].ItemNumber;
                        var description = response[0].ItemDescription;
                        var completeDescription = response[0].CompleteDescription;
                        var drawingNumber = response[0].DrawingNumber;
                        var ITTYP = response[0].ItemType;

                        if (['0', '1', '2', '9'].indexOf(ITTYP) == -1) {
                            alert("XA Error: Item " + itemNumber + " ( Item Type " + ITTYP + " ) cannot have a BOM. Only Types 0, 1, 2, and 9 can have BOMs. Please change the item type using the NICe tool.");
                            $jQ('#lblDescriptionValue').html("");
                            $jQ('#lblDrawingNumberValue').html("");
                            $jQ('#lblDescriptionValue').hide();
                            $jQ('#lblDrawingNumberValue').hide();
                            $jQ("#BOMUploadGrid").hide();
                            $jQ('#lblNoDataMessage').html("XA Error: Item " + itemNumber + " ( Item Type " + ITTYP + " ) cannot have a BOM. Only Types 0, 1, 2, and 9 can have BOMs. Please change the item type using the NICe tool.");
                        }
                        else {
                            $jQ('#lblDescriptionValue').html(description);
                            $jQ('#lblDrawingNumberValue').html(drawingNumber);

                            $jQ('#lblDescriptionValue').show();
                            $jQ('#lblDrawingNumberValue').show();
                            $jQ('#lblNoDataMessage').html("");
                        }
                    },
                    error: function (result) {
                        $jQ.unblockUI();
                    }
                });
            }
        }

        function UploadBomToXA() {
            $jQ.blockUI({
                message: '<img src="../Images/PageLoader.gif" />',
                css: {
                    border: 'none',
                    backgroundColor: 'none',
                    opacity: .7
                }
            });

            var IsDontDelete = [];
            var allrowIds = $jQ("#BOMUploadGrid").jqGrid('getDataIDs');

            allrowIds.forEach(function (rowId) {
                var comprowdata = $jQ("#BOMUploadGrid").jqGrid('getRowData', rowId);
                IsDontDelete.push({ DontDelete: comprowdata.DontDelete === "1", Action: comprowdata.Action, UserSequence: comprowdata.UserSequence, ComponentItemNumber: comprowdata.ComponentItemNumber });

            });

            jQuery.ajax({
                url: "/BOMUpload/UploadBomToXA",
                type: 'POST',
                datatype: "json",
                contentType: 'application/json',
                data: JSON.stringify(IsDontDelete),
                viewrecords: true,
                emptyrecords: "No record found!",
                success: function (result) {
                    // alert(response.redirectUrl);
                    // alert("Upload BOM to XA RESPONSE: " + window.location.origin + result.redirectUrl);
                    window.location.href = result.redirectUrl;
                    //window.location.replace(result.redirectUrl);
                    $jQ.unblockUI();
                },
                error: function (result) {
                    $jQ.unblockUI();
                }

            });
        }

